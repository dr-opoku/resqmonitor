{
  "schema_version": "1.0",
  "name": "resqmonitor",
  "version": "0.2.0",
  "purpose": "Inspect supplied categorical predictions and outcomes",
  "repository": "https://github.com/dr-opoku/resqmonitor",
  "runtime": {
    "python": ">=3.11",
    "core_dependencies": [],
    "network_required": false,
    "model_required": false
  },
  "demo": {
    "command": [
      "python3",
      "-m",
      "resqmonitor",
      "demo",
      "--format",
      "json"
    ],
    "synthetic": true,
    "reference_time": "2026-10-13T12:00:00Z"
  },
  "outputs": [
    "text",
    "json",
    "html"
  ],
  "report_schema_version": "2.0",
  "mcp": {
    "optional_extra": "mcp",
    "transport": "stdio",
    "command": [
      "resqmonitor",
      "serve"
    ]
  },
  "limits": {
    "csv_bytes": 5242880,
    "csv_records": 50000
  },
  "license": {
    "status": "not_selected"
  },
  "evidence_policy": "docs/EVIDENCE_POLICY.md",
  "standards_review": {
    "date": "2026-10-13",
    "window_start": "2026-07-29",
    "document": "docs/STANDARDS_REVIEW.md"
  },
  "related_repositories": [
    "https://github.com/dr-opoku/dataqmonitor",
    "https://github.com/dr-opoku/llm-eval"
  ],
  "case_study": "docs/CASE_STUDY.md",
  "action_plan": "docs/ACTION_PLAN.json",
  "review": "docs/REVIEW.md",
  "project_status": "docs/PROJECT_STATUS.md",
  "verification": "docs/VERIFICATION.json",
  "report_consumer": {
    "command": "python3 scripts/inspect_report.py REPORT.json",
    "exit_codes": {
      "0": "declared sample rules met; no authority granted",
      "1": "negative or insufficient evidence",
      "2": "invalid or error report"
    },
    "authenticity_verified": false
  }
}
